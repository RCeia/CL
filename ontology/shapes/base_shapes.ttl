@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix kl: <http://example.org/kl/ontology#> .
@prefix klsh: <http://example.org/kl/shapes#> .
@prefix schema: <http://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

klsh:WikidataLink a sh:PropertyShape ;
    sh:path owl:sameAs ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://www\\.wikidata\\.org/entity/Q[1-9][0-9]*$" .

klsh:SingleName a sh:PropertyShape ;
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 .

klsh:SingleTmdbId a sh:PropertyShape ;
    sh:path kl:tmdbId ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minExclusive 0 .

klsh:FilmShape a sh:NodeShape ;
    sh:targetClass kl:Film ;
    sh:property klsh:SingleName , klsh:SingleTmdbId , klsh:WikidataLink ;
    sh:property [ sh:path kl:originalTitle ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path kl:imdbId ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^tt[0-9]+$" ] ;
    sh:property [ sh:path schema:datePublished ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path kl:runtimeMinutes ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path kl:budget ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path kl:revenue ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path kl:voteAverage ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 10 ] ;
    sh:property [ sh:path kl:voteCount ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path schema:inLanguage ; sh:maxCount 1 ; sh:class kl:Language ] ;
    sh:property [ sh:path kl:spokenLanguage ; sh:class kl:Language ] ;
    sh:property [ sh:path schema:genre ; sh:class kl:Genre ] ;
    sh:property [ sh:path schema:keywords ; sh:class kl:Keyword ] ;
    sh:property [ sh:path schema:productionCompany ; sh:class kl:ProductionCompany ] ;
    sh:property [ sh:path schema:countryOfOrigin ; sh:class kl:Country ] ;
    sh:property [ sh:path schema:isPartOf ; sh:maxCount 1 ; sh:class kl:FilmCollection ] ;
    sh:property [ sh:path schema:actor ; sh:class kl:Person ] ;
    sh:property [ sh:path schema:director ; sh:class kl:Person ] ;
    sh:property [ sh:path kl:writer ; sh:class kl:Person ] ;
    sh:property [ sh:path kl:hasCastCredit ; sh:class kl:CastCredit ] ;
    sh:property [ sh:path kl:hasCrewCredit ; sh:class kl:CrewCredit ] ;
    sh:property [
        sh:path schema:director ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Film has no director in the snapshot."
    ] .

klsh:PersonShape a sh:NodeShape ;
    sh:targetClass kl:Person ;
    sh:property klsh:SingleName , klsh:SingleTmdbId , klsh:WikidataLink ;
    sh:property [ sh:path schema:gender ; sh:maxCount 1 ; sh:in ( "female" "male" "non-binary" ) ] .

klsh:CreditShape a sh:NodeShape ;
    sh:targetClass kl:CastCredit , kl:CrewCredit ;
    sh:property [ sh:path kl:creditedPerson ; sh:minCount 1 ; sh:maxCount 1 ; sh:class kl:Person ] ;
    sh:property [
        sh:path [ sh:inversePath [ sh:alternativePath ( kl:hasCastCredit kl:hasCrewCredit ) ] ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class kl:Film
    ] .

klsh:CastCreditShape a sh:NodeShape ;
    sh:targetClass kl:CastCredit ;
    sh:property [ sh:path kl:castOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path kl:characterName ; sh:maxCount 1 ; sh:datatype xsd:string ] .

klsh:CrewCreditShape a sh:NodeShape ;
    sh:targetClass kl:CrewCredit ;
    sh:property [ sh:path kl:job ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path kl:department ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

klsh:NamedResourceShape a sh:NodeShape ;
    sh:targetClass kl:Genre , kl:Keyword , kl:ProductionCompany , kl:FilmCollection ;
    sh:property klsh:SingleName , klsh:SingleTmdbId .

klsh:CodedResourceShape a sh:NodeShape ;
    sh:targetClass kl:Country , kl:Language ;
    sh:property klsh:SingleName , klsh:WikidataLink ;
    sh:property [ sh:path kl:isoCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Za-z]{2}$" ] .
